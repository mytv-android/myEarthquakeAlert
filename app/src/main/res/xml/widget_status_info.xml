<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小部件「监测状态」(design §10 实现映射): status + recent warnings, responsive from 1×1 to 4×3. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/wg_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="48dp"
    android:minResizeHeight="48dp"
    android:previewImage="@drawable/ic_wg_preview"
    android:previewLayout="@layout/widget_status_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen|keyguard"
    tools:targetApi="s" />
