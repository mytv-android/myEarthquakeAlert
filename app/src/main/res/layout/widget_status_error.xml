<?xml version="1.0" encoding="utf-8"?>
<!-- Shown by the status widget when its content cannot be built; a tap opens the app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_status_error_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ic_wg_bg"
    android:backgroundTint="#FFF1F4F8"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="@string/wg_error"
        android:textColor="#FF41474D"
        android:textSize="13sp" />
</FrameLayout>
